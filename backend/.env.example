# Copy to .env and fill in. Every var listed in REQUIRED_ENV_VARS in
# src/config/env.js must be present or the server exits at startup.

PORT=5000
NODE_ENV=development

# Postgres connection string used by Prisma (prisma/schema.prisma).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public"

# Redis, used by both the app cache and BullMQ.
REDIS_URL="redis://localhost:6379"

# Signing secret for access tokens. Generate a real one:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="change-me"
JWT_EXPIRY="15m"

# Browser origin allowed through CORS. Optional — defaults to "*".
CLIENT_ORIGIN="http://localhost:3000"

# Pino log level: fatal | error | warn | info | debug | trace | silent.
# Optional — defaults to "debug" in development and "info" otherwise.
LOG_LEVEL="debug"

# ─── Email transport: Nodemailer over SMTP (src/shared/utils/mailer.js) ─────
# Used ONLY by the email worker process (npm run worker:email), never by the
# API server — a request enqueues a job and returns; SMTP latency belongs to
# the worker. Deliberately NOT in REQUIRED_ENV_VARS for the same reason the
# OAuth pair is not: the API boots and serves without them. The worker does
# not — run-email-worker.js verifies the transport at startup and exits, since
# a worker that cannot send is a queue that silently swallows mail.
#
# Gmail rejects an account password over SMTP. HOST_APP_PASSWORD must be a
# 16-character App Password (Google Account → Security → 2-Step Verification →
# App passwords), which is why 2FA has to be on for the sending account.
HOST_MAIL="your-sender@gmail.com"
HOST_APP_PASSWORD="xxxx xxxx xxxx xxxx"

# Optional — defaults target Gmail. Port 587 is STARTTLS, so SMTP_SECURE stays
# false: "secure" means implicit TLS from the first byte, which is port 465
# only. Setting secure=true on 587 hangs the connection rather than erroring.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SECURE=false

# Display name on the From header. The address itself is always HOST_MAIL —
# Gmail rewrites a From that is not the authenticated account, so a separate
# MAIL_FROM address would be silently ignored.
MAIL_FROM_NAME="Tizello"

# ─── Auth: token lifetimes (plan §4.1, §11) ─────────────────────────────────
# JWT_SECRET / JWT_EXPIRY above sign and bound the ACCESS token.
# The refresh token is opaque random bytes, not a JWT, so it needs no secret.
REFRESH_TOKEN_TTL_DAYS=30

# bcrypt work factor for password hashes. Spec §9 floor is 12 — raising it is
# safe, lowering it is not.
BCRYPT_COST=12

# ─── Auth: login codes (plan §3.4) ──────────────────────────────────────────
# 6 digits is only 10^6, so the attempt cap is what makes the code safe, not
# the length. Both are enforced on the LoginCode row, not in Redis.
LOGIN_CODE_TTL_MINUTES=10
LOGIN_CODE_MAX_ATTEMPTS=5

# ─── Auth: registration codes & password reset ───────────────────────────────
# Same shape as the login code above (6 digits, attempt-capped), shorter TTL —
# registration verification is expected in the same sitting as sign-up.
REGISTRATION_CODE_TTL_MINUTES=5
REGISTRATION_CODE_MAX_ATTEMPTS=5
PASSWORD_RESET_TTL_HOURS=1

# ─── Invitations (plan §3.6, §8) ────────────────────────────────────────────
# 7 days must match the shipped frontend copy: "Invitation links last seven
# days." Change one and you must change the other.
INVITE_TTL_DAYS=7
# Per-workspace hourly cap. An admin mass-inviting sends mail from our domain
# to strangers — this is the spam-reputation guard, not an abuse counter.
INVITE_MAX_PER_WORKSPACE_HOUR=50

# ─── Cookies (plan §4.1, §11.1) ─────────────────────────────────────────────
# Leave unset in development: unset means a host-only cookie, which is correct
# for localhost. Set it in production only when the frontend and API share a
# registrable domain (".tizello.com").
# COOKIE_DOMAIN=

# ─── OAuth (plan §5) ────────────────────────────────────────────────────────
# Deliberately NOT in REQUIRED_ENV_VARS: a developer without Google keys must
# still be able to boot and work on password auth. A strategy registers only
# when its pair is present; otherwise its /start route 404s.
# The callback URL is registered in the provider console and must match what we
# send CHARACTER FOR CHARACTER — scheme, host, port, path, trailing slash. It
# is therefore stored as one full URL per provider rather than assembled from a
# base + a path at runtime: a URL built in code is a URL nobody can paste into
# the provider console to compare, and the mismatch surfaces as "redirect_uri
# mismatch" at the provider, not as an error here.
#
# NOTE the path shape: /api/v1/auth/<provider>/callback — there is NO /oauth
# segment. This is what is registered in the GitHub OAuth App; plan §9 and
# sprint 5 were updated to match it rather than the other way round, because
# the console is the side that cannot be changed by a deploy.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:5000/api/v1/auth/google/callback"

GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:5000/api/v1/auth/github/callback"
