{
  "enabledMcpjsonServers": [
    "postgres"
  ],
  "permissions": {
    "allow": [
      "Bash(npx tsc --noEmit*)",
      "Bash(npx tsc -b --noEmit*)",
      "Bash(npm run lint*)",
      "Bash(npm run build*)",
      "Bash(npx eslint *)",
      "Bash(npm view *)",
      "Bash(npm ls *)",
      "Bash(npm info *)",
      "Bash(npm install*)",
      "Bash(npm i *)",
      "Bash(npm ci*)",
      "Bash(npm uninstall *)",
      "Bash(npx prisma generate*)",
      "Bash(npx prisma validate*)",
      "Bash(npx prisma format*)",
      "Bash(npx prisma migrate dev*)",
      "Bash(npx prisma migrate status*)",
      "Bash(npx prisma migrate diff *)",
      "Bash(npm run prisma:generate*)",
      "Bash(npm run prisma:migrate*)",
      "Bash(redis-cli flushall*)",
      "Bash(redis-cli flushdb*)",
      "Bash(redis-cli *)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(psql *)",
      "Bash(docker *)",
      "Bash(npx prisma db push*)",
      "Bash(npx prisma db execute*)"
    ],
    "ask": [
      "Bash(npx prisma migrate resolve*)",
      "Bash(npm publish*)",
      "Bash(pkill *)",
      "Bash(kill *)"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(rm -rf .git*)",
      "Bash(sudo *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(npx prisma migrate reset*)",
      "Bash(npx prisma db push --force-reset*)",
      "Bash(chmod 777 *)",
      "Bash(curl * | bash*)",
      "Bash(curl * | sh*)",
      "Bash(wget * | bash*)",
      "Bash(:(){*"
    ]
  }
}
